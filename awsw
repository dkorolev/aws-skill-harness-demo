# ---------------------------------------------------------------- main

def main():
    if not shutil.which("aws"):
        sys.exit("aws cli not found in PATH")
    p = argparse.ArgumentParser(prog="awsw", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--json", action="store_true", help="raw JSON output")
    p.add_argument("--region", help="restrict regional scans to one region")
    sub = p.add_subparsers(dest="cmd", required=True)
    for name, fn in [("whoami", cmd_whoami), ("regions", cmd_regions),
                     ("ec2", cmd_ec2), ("sgs", cmd_sgs), ("volumes", cmd_volumes),
                     ("elb", cmd_elb), ("certs", cmd_certs), ("rds", cmd_rds),
                     ("ecs", cmd_ecs), ("eips", cmd_eips),
                     ("snapshots", cmd_snapshots), ("amis", cmd_amis),
                     ("vpce", cmd_vpce), ("ses", cmd_ses), ("s3", cmd_s3),
                     ("cloudfront", cmd_cloudfront),
                     ("r53", cmd_r53), ("billing", cmd_billing),
                     ("discover", cmd_discover)]:
        sp = sub.add_parser(name)
        sp.set_defaults(fn=fn)
    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
