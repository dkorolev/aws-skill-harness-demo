# ---------------------------------------------------------------- ecs

def scan_ecs(region):
    clusters = aws("ecs", "list-clusters", region=region)
    out = []
    for arn in (clusters or {}).get("clusterArns", []):
        cluster = arn.split("/")[-1]
        svc_arns = (aws("ecs", "list-services", "--cluster", cluster,
                        region=region) or {}).get("serviceArns", [])
        services = []
        for i in range(0, len(svc_arns), 10):
            d = aws("ecs", "describe-services", "--cluster", cluster,
                    "--services", *svc_arns[i:i + 10], region=region)
            services += (d or {}).get("services", [])
        if not services:
            out.append({"Region": region, "Cluster": cluster, "Service": "-",
                        "Status": "-", "Running": "-", "Launch": "-"})
        for s in services:
            out.append({
                "Region": region,
                "Cluster": cluster,
                "Service": s["serviceName"],
                "Status": s.get("status"),
                "Running": f"{s.get('runningCount', 0)}/{s.get('desiredCount', 0)}",
                "Launch": s.get("launchType") or ",".join(
                    c["capacityProvider"]
                    for c in s.get("capacityProviderStrategy", [])),
            })
    return out


