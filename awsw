#!/usr/bin/env python3
"""awsw — a read-only wrapper around the AWS CLI.

How this is tested: there are no unit tests by design — every subcommand is a
thin read-only mapping onto `aws` CLI output. The tool is exercised end to end
by the executable Markdown harness in this repository: E2E-HARNESS.md uses it
for the Phase 14 teardown-verification sweep.

Subcommands:
  whoami     Who am I: identity, account, aliases, default region
  regions    List all enabled regions
  ec2        EC2 instances (all regions)
  sgs        Security groups (all regions)
  volumes    EBS volumes (all regions)
  elb        Load balancers + target groups (all regions)
  certs      ACM certificates (all regions)
  rds        RDS instances & clusters (all regions)
  ecs        ECS clusters & services (all regions)
  eips       Elastic IPs (all regions)
  snapshots  EBS snapshots owned by this account (all regions)
  amis       AMIs owned by this account (all regions)
  vpce       VPC endpoints (all regions)
  ses        SES verified identities (all regions)
  s3         S3 buckets (global, with per-bucket region)
  cloudfront CloudFront distributions (global)
  r53        Route53 hosted zones + all records
  billing    Month-to-date cost by service (and by region)
  discover   Everything above, in one go

Flags:
  --json     Emit raw JSON instead of tables
  --region R Restrict regional scans to one region
"""
import argparse
import json
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import date, timedelta

MAX_WORKERS = 16


# ---------------------------------------------------------------- plumbing

def aws(*args, region=None, quiet=False):
    """Run an aws cli command, return parsed JSON (or None on error)."""
    cmd = ["aws", *args, "--output", "json"]
    # global calls still need a signing region even when no default is configured
    cmd += ["--region", region or "us-east-1"]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        print(f"  [timeout] {' '.join(args)} ({region})", file=sys.stderr)
        return None
    if out.returncode != 0:
        if not quiet:
            err = out.stderr.strip().splitlines()
            err = err[-1] if err else "unknown error"
            print(f"  [error] {' '.join(args[:2])} ({region or 'global'}): {err}",
                  file=sys.stderr)
        return None
    return json.loads(out.stdout) if out.stdout.strip() else {}


def fan_out(regions, fn):
    """Run fn(region) for every region in parallel -> {region: result}."""
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool:
        results = pool.map(fn, regions)
    return dict(zip(regions, results))


def table(rows, headers):
    """Print an aligned text table."""
    if not rows:
        print("  (none)")
        return
    rows = [[str(c) if c is not None else "-" for c in r] for r in rows]
    widths = [max(len(h), *(len(r[i]) for r in rows)) for i, h in enumerate(headers)]
    line = "  ".join(h.ljust(w) for h, w in zip(headers, widths))
    print(f"  {line}")
    print(f"  {'  '.join('-' * w for w in widths)}")
    for r in rows:
        print("  " + "  ".join(c.ljust(w) for c, w in zip(r, widths)))


def section(title):
    print(f"\n=== {title} " + "=" * max(0, 60 - len(title)))


def tag(tags, key="Name"):
    for t in tags or []:
        if t.get("Key") == key:
            return t.get("Value")
    return None


def get_regions(only=None):
    if only:
        return [only]
    data = aws("ec2", "describe-regions")
    if not data:
        sys.exit("Cannot list regions — check credentials/permissions.")
    return sorted(r["RegionName"] for r in data["Regions"])


# ---------------------------------------------------------------- whoami

def cmd_whoami(args):
    ident = aws("sts", "get-caller-identity")
    if not ident:
        sys.exit("Not authenticated.")
    aliases = aws("iam", "list-account-aliases") or {}
    if args.json:
        ident["AccountAliases"] = aliases.get("AccountAliases", [])
        print(json.dumps(ident, indent=2))
        return
    section("whoami")
    print(f"  Account : {ident['Account']}"
          + (f" ({', '.join(aliases['AccountAliases'])})" if aliases.get("AccountAliases") else ""))
    print(f"  ARN     : {ident['Arn']}")
    print(f"  UserId  : {ident['UserId']}")
    cfg = subprocess.run(["aws", "configure", "get", "region"],
                         capture_output=True, text=True).stdout.strip()
    print(f"  Region  : {cfg or '(not set)'} (default)")


# ---------------------------------------------------------------- regions

def cmd_regions(args):
    regions = get_regions()
    if args.json:
        print(json.dumps(regions, indent=2))
        return
    section(f"enabled regions ({len(regions)})")
    for r in regions:
        print(f"  {r}")


# ---------------------------------------------------------------- ec2

def scan_instances(region):
    data = aws("ec2", "describe-instances", region=region)
    out = []
    for res in (data or {}).get("Reservations", []):
        for i in res["Instances"]:
            out.append({
                "Region": region,
                "AZ": i.get("Placement", {}).get("AvailabilityZone"),
                "Id": i["InstanceId"],
                "Name": tag(i.get("Tags")),
                "Type": i.get("InstanceType"),
                "State": i.get("State", {}).get("Name"),
                "PublicIp": i.get("PublicIpAddress"),
                "PrivateIp": i.get("PrivateIpAddress"),
            })
    return out


def cmd_ec2(args):
    regions = get_regions(args.region)
    found = [i for v in fan_out(regions, scan_instances).values() for i in v]
    if args.json:
        print(json.dumps(found, indent=2))
        return
    section(f"EC2 instances ({len(found)})")
    table([[i["Region"], i["AZ"], i["Id"], i["Name"], i["Type"], i["State"],
            i["PublicIp"], i["PrivateIp"]] for i in found],
          ["REGION", "AZ", "ID", "NAME", "TYPE", "STATE", "PUBLIC IP", "PRIVATE IP"])


