# ---------------------------------------------------------------- elb + target groups

def scan_elb(region):
    lbs = aws("elbv2", "describe-load-balancers", region=region)
    tgs = aws("elbv2", "describe-target-groups", region=region)
    lb_out = []
    for lb in (lbs or {}).get("LoadBalancers", []):
        lb_out.append({
            "Region": region,
            "Name": lb["LoadBalancerName"],
            "Type": lb.get("Type"),
            "Scheme": lb.get("Scheme"),
            "State": lb.get("State", {}).get("Code"),
            "AZs": ",".join(z["ZoneName"] for z in lb.get("AvailabilityZones", [])),
            "DNS": lb.get("DNSName"),
            "Arn": lb["LoadBalancerArn"],
        })
    tg_out = []
    for tg in (tgs or {}).get("TargetGroups", []):
        health = aws("elbv2", "describe-target-health",
                     "--target-group-arn", tg["TargetGroupArn"], region=region)
        targets = (health or {}).get("TargetHealthDescriptions", [])
        healthy = sum(1 for t in targets
                      if t.get("TargetHealth", {}).get("State") == "healthy")
        tg_out.append({
            "Region": region,
            "Name": tg["TargetGroupName"],
            "Protocol": f"{tg.get('Protocol')}:{tg.get('Port')}",
            "TargetType": tg.get("TargetType"),
            "Targets": f"{healthy}/{len(targets)} healthy",
            "LoadBalancers": len(tg.get("LoadBalancerArns", [])),
        })
    return {"lbs": lb_out, "tgs": tg_out}


def cmd_elb(args):
    regions = get_regions(args.region)
    res = fan_out(regions, scan_elb)
    lbs = [x for v in res.values() for x in v["lbs"]]
    tgs = [x for v in res.values() for x in v["tgs"]]
    if args.json:
        print(json.dumps({"LoadBalancers": lbs, "TargetGroups": tgs}, indent=2))
        return
    section(f"load balancers ({len(lbs)})")
    table([[l["Region"], l["Name"], l["Type"], l["Scheme"], l["State"],
            l["AZs"], l["DNS"]] for l in lbs],
          ["REGION", "NAME", "TYPE", "SCHEME", "STATE", "AZs", "DNS"])
    section(f"target groups ({len(tgs)})")
    table([[t["Region"], t["Name"], t["Protocol"], t["TargetType"],
            t["Targets"], t["LoadBalancers"]] for t in tgs],
          ["REGION", "NAME", "PROTO", "TARGET TYPE", "HEALTH", "LBs"])


