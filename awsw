# ---------------------------------------------------------------- route53

def cmd_r53(args):
    zones = aws("route53", "list-hosted-zones") or {}
    zones = zones.get("HostedZones", [])
    result = []
    for z in zones:
        zid = z["Id"].split("/")[-1]
        recs = aws("route53", "list-resource-record-sets",
                   "--hosted-zone-id", zid) or {}
        result.append({"Zone": z["Name"], "Id": zid,
                       "Private": z.get("Config", {}).get("PrivateZone", False),
                       "Records": recs.get("ResourceRecordSets", [])})
    if args.json:
        print(json.dumps(result, indent=2))
        return
    section(f"Route53 hosted zones ({len(result)})")
    for z in result:
        kind = "private" if z["Private"] else "public"
        print(f"\n  {z['Zone']} ({z['Id']}, {kind}, {len(z['Records'])} records)")
        rows = []
        for r in z["Records"]:
            if "AliasTarget" in r:
                value = f"ALIAS -> {r['AliasTarget']['DNSName']}"
            else:
                value = " ".join(rr["Value"] for rr in r.get("ResourceRecords", []))
            rows.append([r["Name"], r["Type"], r.get("TTL", "-"), value[:80]])
        table(rows, ["NAME", "TYPE", "TTL", "VALUE"])


# ---------------------------------------------------------------- billing

def cmd_billing(args):
    today = date.today()
    start = today.replace(day=1).isoformat()
    end = (today + timedelta(days=1)).isoformat()
    by_service = aws("ce", "get-cost-and-usage",
                     "--time-period", f"Start={start},End={end}",
                     "--granularity", "MONTHLY",
                     "--metrics", "UnblendedCost",
                     "--group-by", "Type=DIMENSION,Key=SERVICE",
                     region="us-east-1")
    by_region = aws("ce", "get-cost-and-usage",
                    "--time-period", f"Start={start},End={end}",
                    "--granularity", "MONTHLY",
                    "--metrics", "UnblendedCost",
                    "--group-by", "Type=DIMENSION,Key=REGION",
                    region="us-east-1")
    if not by_service:
        print("Cost Explorer unavailable (needs ce:GetCostAndUsage; "
              "may take 24h to activate on first use).", file=sys.stderr)
        return
    if args.json:
        print(json.dumps({"ByService": by_service, "ByRegion": by_region}, indent=2))
        return

    def rows_of(data):
        rows, unit, total = [], "USD", 0.0
        for g in data["ResultsByTime"][0]["Groups"]:
            amt = float(g["Metrics"]["UnblendedCost"]["Amount"])
            unit = g["Metrics"]["UnblendedCost"]["Unit"]
            total += amt
            if abs(amt) >= 0.005:
                rows.append([g["Keys"][0], f"{amt:.2f}"])
        rows.sort(key=lambda r: -float(r[1]))
        return rows, total, unit

    section(f"billing, month to date ({start} .. {today.isoformat()})")
    rows, total, unit = rows_of(by_service)
    print("\n  By service:")
    table(rows + [["TOTAL", f"{total:.2f}"]], ["SERVICE", unit])
    if by_region:
        rows, total, unit = rows_of(by_region)
        print("\n  By region:")
        table(rows + [["TOTAL", f"{total:.2f}"]], ["REGION", unit])


