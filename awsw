# ---------------------------------------------------------------- s3

def cmd_s3(args):
    buckets = (aws("s3api", "list-buckets") or {}).get("Buckets", [])

    def locate(b):
        loc = aws("s3api", "get-bucket-location", "--bucket", b["Name"],
                  quiet=True)
        region = (loc or {}).get("LocationConstraint") or "us-east-1"
        return {"Name": b["Name"], "Region": region,
                "Created": b["CreationDate"][:10]}

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool:
        found = sorted(pool.map(locate, buckets), key=lambda b: b["Region"])
    if args.json:
        print(json.dumps(found, indent=2))
        return
    section(f"S3 buckets ({len(found)})")
    table([[b["Region"], b["Name"], b["Created"]] for b in found],
          ["REGION", "NAME", "CREATED"])


